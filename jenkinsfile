pipeline {
    agent any

    environment {
        // Set AWS credentials as environment variables
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-key-id')
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout the repository containing your Terraform files
                // git 'https://github.com/Myngahuynh/Jenkins-Infra.git' // Replace with your repo URL
                echo 'Stage Checkout stage completed successfully!'
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    // Initialize Terraform
                    sh 'terraform init'
                    echo 'Stage Init stage completed successfully!'
                }
            }
        }


        stage('Terraform Plan for First EC2') {
            steps {
                script {
                    // Run terraform plan for the first EC2 instance (hello)
                    sh 'terraform plan -target=aws_instance.first_EC2'  // Plan only for the hello instance
                    echo 'Terraform plan for Hello EC2 completed!'
                }
            }
        }

        stage('Terraform Plan for Second EC2') {
            steps {
                script {
                    // Run terraform plan for the second EC2 instance (new_instance)
                    sh 'terraform plan -target=aws_instance.second_EC2'  // Plan only for the new_instance
                    echo 'Terraform plan for New EC2 completed!'
                }
            }
        }

        stage('Confirm') {
            steps {
                script {
                    input message: 'Do you want to apply these changes?', ok: 'Yes, Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    // Apply the changes required to reach the desired state
                    // Use `-auto-approve` to skip the interactive approval
                    sh 'terraform apply -auto-approve'
                    echo 'Stage Apply stage completed successfully!'
                }
            }
        }

           // New Confirm Destroy stage
        stage('Confirm Destroy') {
            steps {
                script {
                    input message: 'Are you sure you want to destroy all resources?', ok: 'Yes, Destroy'
                }
            }
        }

    // Terraform Destroy stage
        stage('Terraform Destroy') {
            steps {
                script {
                    // Destroy all the resources managed by Terraform
                    // WARNING: This will destroy all resources in the current workspace!
                    sh 'terraform destroy -auto-approve'
                    echo 'Stage Destroy stage completed successfully!'
                }
            }
        }

}

    post {
        success {
            echo 'Infrastructure created successfully!'
        }
        failure {
            echo 'Failed to create infrastructure.'
        }
    }
}
