pipeline {
    agent any

    environment {
        // Set AWS credentials as environment variables
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-key-id')
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout the repository containing your Terraform files
                // git 'https://github.com/Myngahuynh/Jenkins-Infra.git' // Replace with your repo URL
                echo 'Stage Checkout stage completed successfully!'
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    // Initialize Terraform
                    sh 'terraform init'
                    echo 'Stage Init stage completed successfully!'
                }
            }
        }


        stage('Terraform Plan for First EC2') {
            steps {
                script {
                    // Run terraform plan for the first EC2 instance (hello)
                    sh 'terraform plan -target=aws_instance.first_EC2'  // Plan only for the hello instance
                    echo 'Terraform plan for Hello EC2 completed!'
                }
            }
        }

        stage('Terraform Plan for Second EC2') {
            steps {
                script {
                    // Run terraform plan for the second EC2 instance (new_instance)
                    sh 'terraform plan -target=aws_instance.second_EC2'  // Plan only for the new_instance
                    echo 'Terraform plan for New EC2 completed!'
                }
            }
        }

        stage('Confirm') {
            steps {
                script {
                    input message: 'Do you want to apply these changes?', ok: 'Yes, Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    // Apply the changes required to reach the desired state
                    // Use `-auto-approve` to skip the interactive approval
                    sh 'terraform apply -auto-approve'
                    echo 'Stage Apply stage completed successfully!'
                }
            }
        }

        stage('Terraform Destroy - Manual Confirmation') {
            steps {
                script {
                    // Prompt for manual confirmation before destruction
                    def userInput = input(
                        id: 'userInput', 
                        message: 'Are you sure you want to destroy the Terraform-managed resources?',
                        parameters: [
                            [$class: 'BooleanParameterDefinition', defaultValue: false, description: 'Confirm if you want to delete the resources', name: 'Confirm Destroy']
                        ]
                    )

                    // Store the confirmation status in an environment variable
                    env.TF_DESTROY_CONFIRMATION = userInput['Confirm Destroy'] ? 'confirmed' : 'rejected'
                    echo "User selection: ${env.TF_DESTROY_CONFIRMATION}"
                }
            }
        }

        // Separate stage for confirmation (True)
        stage('Terraform Destroy - Confirmed') {
            when {
                expression { return env.TF_DESTROY_CONFIRMATION == 'confirmed' }
            }
            steps {
                script {
                    // Proceed to destroy resources if confirmed
                    echo 'User confirmed destruction. Proceeding to destroy resources...'
                    sh 'terraform destroy -auto-approve'  // Destroy all resources in the current state
                    echo 'Terraform destroy completed!'
                }
            }
        }

        // Separate stage for rejection (False)
        stage('Terraform Destroy - Rejected') {
            when {
                expression { return env.TF_DESTROY_CONFIRMATION == 'rejected' }
            }
            steps {
                script {
                    // Skip destruction if rejected
                    echo 'User rejected destruction. Skipping destroy step.'
                }
            }
        }
    }

    post {
        success {
            echo 'Infrastructure created successfully!'
        }
        failure {
            echo 'Failed to create infrastructure.'
        }
    }
}
